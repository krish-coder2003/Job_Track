{
  "name": "server",
  "version": "1.0.0",
  "description": "JobTrack Backend API Server",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 --test-reporter=spec test/user.model.test.js test/auth.register.test.js test/auth.login.test.js test/auth.authorization.test.js test/job.crud.test.js test/job.discovery.test.js test/user.profile.test.js test/job.application.test.js test/job.recruiter.test.js test/admin.test.js test/security.audit.test.js test/ats.test.js",
    "test:ats": "node --test --test-reporter=spec test/ats.test.js",
    "test:security": "node --test --test-reporter=spec test/security.audit.test.js",
    "test:model": "node --test --test-reporter=spec test/user.model.test.js",
    "test:register": "node --test --test-reporter=spec test/auth.register.test.js",
    "test:login": "node --test --test-reporter=spec test/auth.login.test.js",
    "test:authz": "node --test --test-reporter=spec test/auth.authorization.test.js",
    "test:jobs": "node --test --test-reporter=spec test/job.crud.test.js",
    "test:discovery": "node --test --test-reporter=spec test/job.discovery.test.js",
    "test:profile": "node --test --test-reporter=spec test/user.profile.test.js",
    "test:application": "node --test --test-reporter=spec test/job.application.test.js",
    "test:recruiter": "node --test --test-reporter=spec test/job.recruiter.test.js",
    "test:admin": "node --test --test-reporter=spec test/admin.test.js",
    "test:auth": "node --test --test-reporter=spec test/auth.register.test.js test/auth.login.test.js",
    "seed:admin": "node src/scripts/seedAdmin.js"
  },
  "keywords": [
    "express",
    "jobtrack",
    "api",
    "mongodb",
    "mongoose"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  }
}
