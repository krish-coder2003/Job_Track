# Server Port
PORT=5000

# Environment Mode (development, production, test)
NODE_ENV=development

# MongoDB Connection URI
# Option 1 - Local MongoDB (Default):
# MONGODB_URI=mongodb://localhost:27017/jobtrack
# Option 2 - MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/jobtrack

# Allowed Client Origin for CORS (React dev server or production frontend)
CLIENT_URL=http://localhost:5173

# JWT Authentication
# Secret key used to sign and verify JSON Web Tokens (min 32 characters in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
# Token expiration time (e.g. 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d

# Private Object Storage (Cloudinary - Optional)
# If provided, resumes are stored in private Cloudinary storage with signed token access.
# If omitted, JobTrack automatically runs in safe local private development mode (server/storage/private/resumes).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


